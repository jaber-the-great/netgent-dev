# NetGent v2 configuration
# Copy to .env and fill in what you use. Only `netgent generate` and `netgent eval`
# need an LLM key; `netgent run` executes compiled workflows with no LLM calls.

# ── LLM provider keys (set at least one) ─────────────────────────────────────
# API-key auth only for now (no Vertex AI / service-account path).
# Set several to allow fallback across providers.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Model selection (litellm-style "provider/model" strings) ─────────────────
# Generation is the smart/expensive role; execution needs no LLM at all.
NETGENT_GENERATOR_MODEL=gemini/gemini-2.5-pro
# Optional cheap model for micro-tasks (state checks, judging in `netgent eval`)
NETGENT_SECONDARY_MODEL=

# ── Browser ──────────────────────────────────────────────────────────────────
NETGENT_HEADLESS=false
# Path to a Chrome/Chromium binary (auto-detected if empty)
NETGENT_BROWSER_EXECUTABLE=
# Reuse an existing browser profile to inherit logged-in sessions
NETGENT_BROWSER_STORAGE_DIR=
# Explore-agent observation backend: dom (injected DOM walk) | ax (accessibility tree, hybrid).
# See docs/research/accessibility-tree-observation.md for the A/B.
NETGENT_OBSERVATION=dom

# ── Site credentials (logins for the apps a workflow drives) ─────────────────
# Keep these separate from LLM keys. Path to a credentials JSON file; can also
# be passed per-run via `--credentials`.
NETGENT_CREDENTIALS_FILE=

# ── Ops (optional) ───────────────────────────────────────────────────────────
# LangSmith tracing (carried over from v1)
LANGSMITH_API_KEY=
NETGENT_LOG_LEVEL=info
